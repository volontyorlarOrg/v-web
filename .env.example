# Every NEXT_PUBLIC_* value is embedded in the browser bundle. Never put a
# secret here, and keep real local values in .env.local (which is not tracked).
#
# All four values are optional and blank on purpose: no domain, product-app
# host, or social address is verified for Volontyor yet. The site degrades honestly
# when one is missing rather than guessing.

# Canonical marketing origin, e.g. https://example.org — origin only, no path.
# While this is empty the site sends `noindex`, robots.txt disallows crawling,
# and the sitemap is empty, so an unverified host can never be indexed.
NEXT_PUBLIC_SITE_URL=

# Origin of the separate authenticated Volontyor application. While it is empty the
# "open the app" calls to action are not rendered at all.
NEXT_PUBLIC_APP_ORIGIN=

# Public community channels. Must be https URLs. Each channel is hidden from
# the footer and contact page until its address is supplied.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
